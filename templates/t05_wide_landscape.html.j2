{# Landscape A4 with a wide item grid and a statutory HSN summary. Common in
   distribution/wholesale where many columns must fit. #}
<style>{{ base_css }}
@page { size: A4 landscape; margin: 8mm; }
body { font-family: Arial, Helvetica, sans-serif; font-size: 8pt; }
.hdr { display:flex; justify-content:space-between; border-bottom:2.5px solid #000; padding-bottom:5px; }
td, th { border:1px solid #555; padding:2px 4px; }
th { background:#ddd; font-size:7pt; }
.np td { border:none; padding:1px 3px; }
.tag { border:1.5px solid #000; padding:2px 7px; font-weight:bold; font-size:7.5pt; }
</style>
<div class="hdr">
  <div><div style="font-size:15pt;font-weight:bold">{{ r.seller_name }}</div>
    <div>{{ sa.line1 }}, {{ sa.city }}, {{ sa.state }} - {{ sa.pincode }}</div>
    <div>GSTIN <b>{{ r.seller_gstin }}</b> &nbsp; State Code {{ sa.state_code }}</div></div>
  <div style="text-align:right"><div class="tag">ORIGINAL FOR RECIPIENT</div>
    <div style="margin-top:5px">Invoice No <b>{{ r.invoice_number }}</b></div>
    <div>Invoice Date <b>{{ d.dmy_dash }}</b></div>
    <div>Terms {{ terms }}</div></div>
</div>
<table class="np" style="margin:5px 0">
  <tr><td style="width:50%"><b>Billed To</b><br>{{ r.buyer_name }}<br>{{ ba.line1 }}, {{ ba.city }}, {{ ba.state }} - {{ ba.pincode }}<br>
      GSTIN {{ r.buyer_gstin or 'Unregistered' }} &nbsp; Place of Supply {{ ba.state }} ({{ ba.state_code }})</td>
    <td><b>Shipped To</b><br>{{ r.buyer_name }}<br>{{ ba.line1 }}, {{ ba.city }}<br>
      Reverse Charge: {{ 'Yes' if r.reverse_charge else 'No' }}</td></tr>
</table>
<table>
  <tr><th>#</th><th>Description of Goods / Services</th><th>HSN</th><th>Qty</th><th>UOM</th><th>Rate</th>
      <th>Disc</th><th>Taxable</th><th>GST%</th>
      {% if interstate %}<th>IGST</th>{% else %}<th>CGST</th><th>SGST</th>{% endif %}<th>Line Total</th></tr>
  {% for it in items %}
  <tr><td class="c">{{ loop.index }}</td><td>{{ it.description }}</td><td class="c">{{ it.hsn_sac }}</td>
    <td class="r">{{ it.quantity }}</td><td class="c">{{ it.unit }}</td><td class="r">{{ it.unit_price }}</td>
    <td class="r">{{ it.discount or '' }}</td><td class="r">{{ it.taxable_value }}</td><td class="c">{{ it.tax_rate }}</td>
    {% if interstate %}<td class="r">{{ it._igst }}</td>{% else %}<td class="r">{{ it._cgst }}</td><td class="r">{{ it._sgst }}</td>{% endif %}
    <td class="r">{{ it._line_total }}</td></tr>
  {% endfor %}
</table>
<div style="display:flex;margin-top:6px;gap:10px">
  <table style="width:45%"><tr><th colspan="4">HSN Summary</th></tr>
    <tr><th>HSN</th><th>Taxable</th><th>Rate</th><th>Tax</th></tr>
    {% for h in hsn_summary %}<tr><td>{{ h.hsn }}</td><td class="r">{{ h.taxable }}</td><td class="c">{{ h.rate }}%</td><td class="r">{{ h.tax }}</td></tr>{% endfor %}
  </table>
  <table style="width:33%;margin-left:auto" class="np">
    <tr><td>Taxable Amount</td><td class="r">{{ r.total_taxable_value }}</td></tr>
    {% if interstate %}<tr><td>IGST</td><td class="r">{{ r.igst_amount }}</td></tr>
    {% else %}<tr><td>CGST</td><td class="r">{{ r.cgst_amount }}</td></tr><tr><td>SGST</td><td class="r">{{ r.sgst_amount }}</td></tr>{% endif %}
    <tr><td>Round Off</td><td class="r">{{ r.round_off }}</td></tr>
    <tr style="border-top:2px solid #000"><td class="b">Total</td><td class="r b">{{ r.grand_total }}</td></tr>
  </table>
</div>
<div style="margin-top:4px">Amount in words: <b>{{ r.amount_in_words }}</b></div>
